# Copy to .env for local development. Never commit the populated .env file.

# Database
POSTGRES_DB=realestate
POSTGRES_USER=realestate
POSTGRES_PASSWORD=replace-with-a-unique-random-password
DATABASE_URL=postgresql://realestate:replace-with-a-unique-random-password@localhost:5432/realestate
REDIS_URL=redis://localhost:6379

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Mapbox
MAPBOX_TOKEN=

# Optional integrations
HELLOSIGN_API_KEY=
SENDGRID_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.mn
